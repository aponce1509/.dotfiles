#!/usr/bin/env zsh
# Session picker for WezTerm.
#
# Naming model: docs/session-model.md §5. `directory_finder --ids` computes a
# stable session id from the repo topology:
#
#   (git)  <path rel. to root>    e.g. python-core
#   (sub)  <path rel. to root>    e.g. learning-git/python-core
#   (wt)   <repo>@<ref>           e.g. python-core@feature
#   (bare) <normalized basename>  e.g. python-core-git
#   (dir)  <path rel. to root>
#
# With one argument, open that path directly and derive the id from its
# basename (used by the `Ctrl+a i` binding, which passes ~/.dotfiles).

emulate -L zsh

die() { print -u2 -- "$1"; exit 1 }

command -v wezterm >/dev/null || die "wezterm is not installed. Please install it first."
[[ -n $WEZTERM_CONFIG_DIR ]] || die "You have to execute this in a wezterm terminal"
command -v fzf >/dev/null || die "fzf is not installed. Please install it first."
command -v directory_finder >/dev/null || die "directory_finder is not installed. Please install it first."

roots=(~/ai-repos ~/ai-repos/ales-os)

# Escape a value for embedding in a JSON string.
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# Mirror directory_finder's slug rules for a single path segment: lowercase,
# anything outside [a-z0-9@/-] becomes '-', collapse runs, trim dashes.
slug() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9@\/-]/-/g; s/--*/-/g; s/^-//; s/-$//'
}

# Rewrite "(<type>)\t<id>\t<path>" as "<display>\t<type>\t<id>\t<path>": a
# coloured type badge, a bold id and the dim parent folder. fzf shows only the
# display column; the rest is read back after selection.
format_rows() {
  local reset=$'\e[0m' bold=$'\e[1m' dim=$'\e[2m' color tag id path parent
  while IFS=$'\t' read -r tag id path; do
    tag=${${tag#\(}%\)}
    case $tag in
      git) color=$'\e[38;5;114m' ;;
      wt) color=$'\e[38;5;215m' ;;
      sub) color=$'\e[38;5;176m' ;;
      bare) color=$'\e[38;5;245m' ;;
      *) color=$'\e[38;5;110m' ;;
    esac
    parent=${${path#~/ai-repos/}:h}
    [[ $parent == . ]] && parent=
    printf '%s %-4s %s %s%-26s%s %s%s%s\t%s\t%s\t%s\n' \
      "$color" "$tag" "$reset" "$bold" "$id" "$reset" "$dim" "$parent" "$reset" \
      "$tag" "$id" "$path"
  done
}

if (( $# >= 1 )); then
  selected_id=$(slug "$(basename -- "$1")")
  selected_cwd=$1
else
  selected=$(
    directory_finder "${roots[@]}" --depth 1 --ids | format_rows |
      fzf --ansi --delimiter=$'\t' --with-nth=1 --nth=1
  )
  [[ -z $selected ]] && exit 0
  IFS=$'\t' read -r _ tag selected_id selected_cwd <<< "$selected"
fi

[[ -z $selected_cwd || -z $selected_id ]] && exit 0

# Emit a "hacky user command": .wezterm.lua decodes this and dispatches to
# utils.hacky_user_commands['switch-workspace']. `base64 | tr -d '\n'` keeps the
# OSC 1337 payload on one line (GNU base64 wraps at 76 cols).
payload=$(printf '{"cmd":"switch-workspace","cwd":"%s","name":"%s"}' \
  "$(json_escape "$selected_cwd")" "$(json_escape "$selected_id")")
encoded=$(printf '%s' "$payload" | base64 | tr -d '\n')
printf '\033]1337;SetUserVar=%s=%s\007' hacky-user-command "$encoded"

# Close the temporary picker pane/tab.
wezterm cli kill-pane
exit 0
